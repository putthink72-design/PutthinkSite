NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/putthink

# Public site origin (magic-link redirect). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data Room — human review then magic link
# Generate a long random string for the admin console (/data-room/admin).
DATA_ROOM_ADMIN_SECRET=
# Where new requests are emailed (optional; needs RESEND_API_KEY).
DATA_ROOM_NOTIFY_EMAIL=goriccc@gmail.com
# Locale path after magic-link login
DATA_ROOM_LOGIN_PATH=/en/data-room
# Set to 1 to keep open mock dashboard + demo preview button (pre-launch only).
# DATA_ROOM_ALLOW_DEMO_PREVIEW=1
# NEXT_PUBLIC_DATA_ROOM_ALLOW_DEMO_PREVIEW=1

# Optional branded email (Resend). Without this, magic links use Supabase Auth email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Putthink Data Room <noreply@yourdomain.com>

# Supabase Auth → enable Email (magic link) provider.
# Redirect URL allowlist:
#   http://localhost:3000/auth/callback
#   https://YOUR_DOMAIN/auth/callback
# Also enable Apple + Google for community likes.
